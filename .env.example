# Copy to .env (never commit .env). Sections and order mirror app/core/config.py::Settings.
# The host flow (make dev) and docker compose (make up) both read this file.

# ── service ────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# LOG_JSON=                         # empty = pretty logs in development, JSON elsewhere

# ── api / auth ─────────────────────────────────────────────
# Development only: skip the X-API-Key check. Refused when APP_ENV=production.
AUTH_DISABLED=true
# Whitespace-separated Argon2id hashes; generate with `make hash-key`. Hashes contain `$`, so keep
# the SINGLE quotes: neither docker compose nor dotenv expands $ inside single quotes.
API_KEY_HASHES=''
MAX_UPLOAD_MB=200                   # request body limit (413 above it)
MAX_EXTRACTED_MB=1000               # total size of extracted zip contents per migration
MAX_UPLOAD_FILES=5000
CORS_ORIGINS=                       # comma-separated, e.g. http://localhost:3000

# ── storage ────────────────────────────────────────────────
# Job records, uploads and generated artifacts live under OUTPUT_DIR/jobs/<id>/ (docker: /app/output).
OUTPUT_DIR=output
OBJECT_STORE_BACKEND=local

# ── orchestration / budgets ────────────────────────────────
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_S=3600

# ── databricks ─────────────────────────────────────────────
DATABRICKS_TIMEOUT_S=90
DATABRICKS_MAX_RETRIES=3
DATABRICKS_MAX_NOTEBOOKS=5000
# Data copy (options.copy_data): tables above the row cap are skipped (use export_to_staging).
DATA_COPY_MAX_ROWS=10000000
# EXTERNAL_LINKS downloads result chunks from presigned *.blob.core.windows.net URLs (must be reachable);
# INLINE stays on the workspace host but Databricks caps an inline result at 25 MiB.
DATA_COPY_DISPOSITION=EXTERNAL_LINKS
DATA_COPY_STATEMENT_TIMEOUT_S=1800
DATA_COPY_POLL_S=2
DATA_COPY_FOLDER=dbx_migration
# Files copy (volumes no shortcut serves, workspace files) -> lakehouse Files/
FILE_COPY_MAX_FILES=10000
FILE_COPY_MAX_FILE_MB=512
FILE_COPY_MAX_TOTAL_MB=20480

# ── fabric ─────────────────────────────────────────────────
FABRIC_API_BASE=https://api.fabric.microsoft.com/v1
FABRIC_AUTHORITY=https://login.microsoftonline.com
FABRIC_SCOPE=https://api.fabric.microsoft.com/.default
FABRIC_TIMEOUT_S=120
FABRIC_LRO_POLL_S=2
FABRIC_LRO_MAX_POLLS=150
FABRIC_MAX_THROTTLE_RETRIES=4
ONELAKE_DFS_BASE=https://onelake.dfs.fabric.microsoft.com
ONELAKE_SCOPE=https://storage.azure.com/.default
FABRIC_JOB_POLL_S=10                # loader / view notebook runs
FABRIC_JOB_TIMEOUT_S=3600

# ── dev credential fallbacks (refused in production) ───────
# When true, requests may omit credentials (the values below are used) or send env://NAME references.
ALLOW_ENV_CREDENTIALS=false
DATABRICKS_HOST=                    # https://adb-<id>.<n>.azuredatabricks.net
# Databricks: service principal OR token; when CLIENT_ID + CLIENT_SECRET are set they are used and the token is ignored
DATABRICKS_CLIENT_ID=               # OAuth M2M service principal
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=                   # or a dapi... personal access token
# Fabric: service principal only
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=              # alternative to the id, e.g. Alteryx_Fabric
FABRIC_LAKEHOUSE=                   # destination lakehouse for all catalogs, e.g. Src_LK
# Development only: allow http:// and private Databricks hosts (local mocks).
ALLOW_PRIVATE_HOSTS=false

# ── ai / agent ─────────────────────────────────────────────
# Needed for options.mode=agent and options.ai_fix.
LLM_PROVIDER=anthropic              # anthropic | azure_openai
# anthropic: needs the `ai` extra (included in the Docker image)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=high                      # low | medium | high | xhigh | max | empty to omit
AI_MAX_TOKENS=16000
AI_TIMEOUT_S=300
AI_MAX_RETRIES=2
AI_REFUSAL_FALLBACK=true            # Claude API only; set false behind Bedrock/Vertex/Foundry gateways
# azure_openai: resource endpoint, key, DEPLOYMENT name and API version (AI_MAX_TOKENS -> max_completion_tokens)
LLM_BASE_URL=                       # https://<resource>.openai.azure.com
LLM_API_KEY=
LLM_MODEL=                          # deployment name, e.g. gpt-5.4-2
LLM_API_VERSION=2025-01-01-preview
LLM_SEND_REASONING_EFFORT=false     # send AI_EFFORT (low|medium|high) as reasoning_effort
AGENT_MAX_TURNS=40
AI_MAX_CELLS_PER_JOB=200

# ── docker compose only ────────────────────────────────────
# API_PORT=8000
# DOCKER_EXTRAS=ai                  # "" builds the image without the Anthropic SDK
